# Server Port
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/brijrani_erp

# JWT Security Keys
JWT_ACCESS_SECRET=access_token_secret_key_secure_xyz_123
JWT_REFRESH_SECRET=refresh_token_secret_key_secure_xyz_123
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis Schedulers & Caching
REDIS_URL=redis://127.0.0.1:6379

# SMTP Mail Server (Mock / Mailtrap ready)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user_id
SMTP_PASSWORD=mock_smtp_password
SMTP_FROM=no-reply@brijranierp.com

# Cloudinary Document Repository
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret

# E-Way Bill Provider Gateway
EWAY_API_URL=https://api.mock-ewaybill-nic.in/v1
EWAY_API_KEY=mock_nic_gateway_api_key

# CORS Whitelists
FRONTEND_URL=http://localhost:3000
